        "custom_liquid": "<style>\n  .partner-badge {\n    background: radial-gradient(circle at center, rgba(255, 215, 0, 0.08), rgba(0, 0, 0, 0.4));\n    border: 1px solid rgba(212, 175, 55, 0.25);\n    border-radius: 20px;\n    padding: 40px 30px;\n    text-align: center;\n    margin: 60px auto;\n    max-width: 640px;\n    box-shadow: 0 0 24px rgba(255, 215, 0, 0.05);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .partner-badge::before {\n    content: \"\";\n    position: absolute;\n    width: 300px;\n    height: 300px;\n    background: radial-gradient(circle, rgba(212,175,55,0.15) 0%, transparent 70%);\n    border-radius: 50%;\n    top: -100px;\n    left: calc(50% - 150px);\n    z-index: 0;\n    animation: pulseRing 5s infinite ease-in-out;\n  }\n\n  .partner-badge h2 {\n    font-size: 28px;\n    color: #FFD976;\n    margin: 0;\n    z-index: 2;\n    position: relative;\n    font-weight: 800;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n  }\n\n  .partner-badge p {\n    font-size: 14px;\n    color: #aaa;\n    margin-top: 10px;\n    letter-spacing: 0.5px;\n    z-index: 2;\n    position: relative;\n  }\n\n  @keyframes pulseRing {\n    0%, 100% {\n      transform: scale(1);\n      opacity: 0.25;\n    }\n    50% {\n      transform: scale(1.2);\n      opacity: 0.4;\n    }\n  }\n</style>\n\n<div class=\"partner-badge\">\n  <h2>Official Sponsor of Raw Garden</h2>\n  <p>Based in California</p>\n</div>",
