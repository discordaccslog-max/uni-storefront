    "custom_liquid_eaipxN": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  /* --- REMOVE THE RIDE THEME DIVIDER / BORDER ONLY FOR THIS SECTION --- */\n  .shopify-section:has(.nx-wrap),\n  .shopify-section:has(.nx-wrap)::before,\n  .shopify-section:has(.nx-wrap)::after {\n    border: 0 !important;\n    box-shadow: none !important;\n    background: transparent !important;\n  }\n  /* Some themes add backgrounds on nested color wrappers — make them transparent here */\n  .shopify-section:has(.nx-wrap) *[class*=\"color-background\"] {\n    background: transparent !important;\n  }\n\n  /* ---- Your section styles ---- */\n  :root{\n    --bg:#0F0F10;\n    --card:#161718;\n    --ink:#F7F7F7;\n    --muted:#A5A7AC;\n    --gold:#D4AF37;\n    --gold-2:#BA9930;\n    --stroke:rgba(212,175,55,.28);\n  }\n  .nx-wrap{color:var(--ink);background:var(--bg);border:1px solid rgba(255,255,255,.05);border-radius:18px;padding:28px 22px;margin:28px 0}\n  .nx-kicker{display:inline-block;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:#FFD976;background:rgba(212,175,55,.08);border:1px solid var(--stroke);border-radius:999px;padding:6px 10px;margin-bottom:12px}\n  .nx-h1{font-size:clamp(28px,4vw,44px);line-height:1.1;margin:0 0 6px;font-weight:800}\n  .nx-sub{color:var(--muted);font-size:clamp(14px,2.2vw,16px);margin:0 0 18px}\n  .nx-cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:8px}\n  .nx-btn{appearance:none;cursor:pointer;border:none;border-radius:12px;padding:12px 18px;font-weight:800}\n  .nx-btn--gold{background:linear-gradient(180deg,#E8C766,#BA9930);color:#111;box-shadow:0 12px 28px rgba(186,153,48,.26)}\n  .nx-btn--hollow{background:transparent;color:var(--ink);border:1px solid var(--stroke)}\n  .nx-grid{display:grid;gap:16px}\n  .nx-3{grid-template-columns:repeat(3,minmax(0,1fr))}\n  .nx-4{grid-template-columns:repeat(4,minmax(0,1fr))}\n  @media(max-width:980px){.nx-3{grid-template-columns:repeat(2,1fr)}.nx-4{grid-template-columns:repeat(2,1fr)}}\n  @media(max-width:620px){.nx-3,.nx-4{grid-template-columns:1fr}}\n  .nx-card{background:var(--card);border:1px solid rgba(255,255,255,.06);border-radius:14px;padding:16px}\n  .nx-card h3{margin:8px 0;font-size:18px;font-weight:800}\n  .nx-card p{margin:6px 0 0;color:var(--muted);font-size:14px}\n  .nx-icon{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;background:rgba(212,175,55,.12);border:1px solid var(--stroke);color:#FFD976;font-weight:900}\n  .nx-step{display:flex;gap:14px;align-items:flex-start}\n  .nx-step .num{min-width:34px;height:34px;border-radius:999px;background:rgba(212,175,55,.14);border:1px solid var(--stroke);display:grid;place-items:center;font-weight:800;color:#FFD976}\n  .nx-strip{display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:center;background:linear-gradient(180deg,#171719,#141416);border:1px solid var(--stroke);border-radius:14px;padding:14px;margin:18px 0}\n  .nx-pill{border:1px solid var(--stroke);color:#FFD976;background:rgba(212,175,55,.08);border-radius:999px;padding:6px 10px;font-size:12px}\n  .nx-faq{border:1px solid rgba(255,255,255,.06);border-radius:14px;overflow:hidden}\n  .nx-faq details{border-top:1px solid rgba(255,255,255,.06)}\n  .nx-faq details:first-of-type{border-top:0}\n  .nx-faq summary{cursor:pointer;padding:14px 16px;background:var(--card);font-weight:700;list-style:none}\n  .nx-faq summary::-webkit-details-marker{display:none}\n  .nx-faq .ans{padding:0 16px 14px;color:var(--muted);background:#121314}\n  .nx-note{color:#A5A7AC;font-size:12.5px;margin-top:10px}\n  .nx-note strong{color:#FFD976}\n</style>\n\n<section class=\"nx-wrap\">\n  <!-- HERO / INTRO -->\n  <span class=\"nx-kicker\">Premium • Fast • Verified</span>\n  <h2 class=\"nx-h1\">Dispensary-Sourced Vapes. Delivered To Your Door.</h2>\n  <p class=\"nx-sub\">\n    We source directly from licensed dispensaries and deliver to you quickly and discreetly.\n    Every product is authenticated and quality-checked so you always know exactly what you’re getting.\n  </p>\n  <div class=\"nx-cta\">\n    <a href=\"/collections/all\" class=\"nx-btn nx-btn--gold\">Explore Products</a>\n    \n  <!-- VALUE PROPS -->\n  <div class=\"nx-grid nx-3\" style=\"margin-top:22px\">\n    <div class=\"nx-card\">\n      <div class=\"nx-icon\">🏷️</div>\n      <h3>Dispensary Direct</h3>\n      <p>We only partner with licensed dispensaries so products remain compliant, traceable, and fresh.</p>\n    </div>\n    <div class=\"nx-card\">\n      <div class=\"nx-icon\">✅</div>\n      <h3>Authenticated & Verified</h3>\n      <p>Each item is sealed, batch-checked, and verified for authenticity before it ships to you.</p>\n    </div>\n    <div class=\"nx-card\">\n      <div class=\"nx-icon\">🚚</div>\n      <h3>Fast, Discreet Delivery</h3>\n      <p>Plain packaging, real-time updates, and quick fulfillment — your privacy comes first.</p>\n    </div>\n  </div>\n\n  <!-- HOW IT WORKS -->\n  <div style=\"margin-top:26px\">\n    <span class=\"nx-kicker\">How it works</span>\n    <div class=\"nx-grid nx-4\">\n      <div class=\"nx-card nx-step\">\n        <div class=\"num\">1</div>\n        <div>\n          <h3>Browse</h3>\n          <p>Choose verified products curated from trusted dispensaries.</p>\n        </div>\n      </div>\n      <div class=\"nx-card nx-step\">\n        <div class=\"num\">2</div>\n        <div>\n          <h3>Verify</h3>\n          <p>We confirm authenticity, seal integrity, and batch details on every item.</p>\n        </div>\n      </div>\n      <div class=\"nx-card nx-step\">\n        <div class=\"num\">3</div>\n        <div>\n          <h3>Deliver</h3>\n          <p>Your order ships quickly in discreet, protective packaging with tracking.</p>\n        </div>\n      </div>\n      <div class=\"nx-card nx-step\">\n        <div class=\"num\">4</div>\n        <div>\n          <h3>Enjoy</h3>\n          <p>Open-box confidence: what you ordered is exactly what arrives — verified.</p>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- VERIFICATION STRIP -->\n  <div class=\"nx-strip\" aria-label=\"Assurances\">\n    <span class=\"nx-pill\">Licensed sourcing</span>\n    <span class=\"nx-pill\">Tamper-evident seals</span>\n    <span class=\"nx-pill\">Batch / lot checks</span>\n    \n    <span class=\"nx-pill\">Discreet packaging</span>\n  </div>\n\n  <!-- FAQs -->\n  <div style=\"margin-top:10px\">\n    <span class=\"nx-kicker\">FAQs</span>\n    <div class=\"nx-faq\">\n      <details>\n        <summary>Where do you source products?</summary>\n        <div class=\"ans\">Exclusively from licensed dispensaries and authorized suppliers. We do not purchase from grey-market sources.</div>\n      </details>\n      <details>\n        <summary>How do you verify authenticity?</summary>\n        <div class=\"ans\">We inspect tamper-evident seals, confirm batch/lot info, and cross-check with supplier data. If an item doesn’t pass, it doesn’t ship.</div>\n      </details>\n      <details>\n        <summary>What does delivery look like?</summary>\n        <div class=\"ans\">Your order ships quickly in plain packaging with full tracking. Delivery timelines are shown at checkout based on your address.</div>\n      </details>\n          </div>\n    <p class=\"nx-note\">\n      <strong>Important:</strong> By ordering you confirm you are 21+ and agree to abide by all local regulations. Availability may vary by region.\n    </p>\n  </div>\n</section>",
