    "custom_liquid_6cqm9L": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign bulk_notice_seconds = 9 %}\n\n<div id=\"bulk-news-notice\" class=\"bulk-news-notice\" role=\"status\" aria-live=\"polite\">\n  <div class=\"bulk-news-notice__inner\">\n    <div class=\"bulk-news-notice__bar\"></div>\n\n    <div class=\"bulk-news-notice__header\">\n      <span class=\"bulk-news-notice__tag\">NEWS</span>\n\n      <button\n        type=\"button\"\n        class=\"bulk-news-notice__close\"\n        aria-label=\"Close notification\"\n        onclick=\"document.getElementById('bulk-news-notice').classList.add('is-hiding')\"\n      >\n        ×\n      </button>\n    </div>\n\n    <div class=\"bulk-news-notice__headline\">\n      GEEK BAR PULSE X BULK OPTIONS COMING SOON\n    </div>\n  </div>\n</div>\n\n<style>\n  .bulk-news-notice {\n    position: fixed;\n    right: 24px;\n    bottom: 24px;\n    z-index: 9999;\n    width: min(430px, calc(100vw - 32px));\n    animation: bulkNewsSlideIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;\n  }\n\n  .bulk-news-notice__inner {\n    position: relative;\n    overflow: hidden;\n    background: linear-gradient(180deg, #121212 0%, #090909 100%);\n    border: 1px solid rgba(201, 162, 39, 0.32);\n    border-radius: 14px;\n    padding: 16px 18px 18px;\n    box-shadow:\n      0 18px 40px rgba(0, 0, 0, 0.42),\n      0 0 0 1px rgba(255, 215, 120, 0.04) inset;\n  }\n\n  .bulk-news-notice__inner::before {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    background: linear-gradient(\n      135deg,\n      rgba(201, 162, 39, 0.08) 0%,\n      rgba(201, 162, 39, 0.02) 28%,\n      transparent 60%\n    );\n  }\n\n  .bulk-news-notice__bar {\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 3px;\n    background: linear-gradient(90deg, #8f6a16 0%, #d7b24d 50%, #8f6a16 100%);\n  }\n\n  .bulk-news-notice__header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 14px;\n    gap: 12px;\n  }\n\n  .bulk-news-notice__tag {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 5px 10px;\n    min-height: 24px;\n    border-radius: 999px;\n    border: 1px solid rgba(201, 162, 39, 0.26);\n    background: rgba(201, 162, 39, 0.10);\n    color: #e7c86f;\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    text-transform: uppercase;\n    line-height: 1;\n  }\n\n  .bulk-news-notice__headline {\n    color: #f6f0dc;\n    font-size: 19px;\n    line-height: 1.3;\n    font-weight: 800;\n    letter-spacing: 0.03em;\n    text-transform: uppercase;\n    max-width: 92%;\n  }\n\n  .bulk-news-notice__close {\n    appearance: none;\n    border: 0;\n    background: transparent;\n    color: rgba(255, 245, 220, 0.72);\n    width: 28px;\n    height: 28px;\n    border-radius: 50%;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 22px;\n    line-height: 1;\n    cursor: pointer;\n    transition: all 0.2s ease;\n    padding: 0;\n    margin: 0;\n  }\n\n  .bulk-news-notice__close:hover {\n    color: #ffffff;\n    background: rgba(201, 162, 39, 0.10);\n  }\n\n  .bulk-news-notice.is-hiding {\n    animation: bulkNewsFadeOut 0.4s ease forwards;\n    pointer-events: none;\n  }\n\n  @keyframes bulkNewsSlideIn {\n    0% {\n      opacity: 0;\n      transform: translateY(24px) scale(0.97);\n    }\n    100% {\n      opacity: 1;\n      transform: translateY(0) scale(1);\n    }\n  }\n\n  @keyframes bulkNewsFadeOut {\n    0% {\n      opacity: 1;\n      transform: translateY(0) scale(1);\n    }\n    100% {\n      opacity: 0;\n      transform: translateY(12px) scale(0.985);\n      visibility: hidden;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .bulk-news-notice {\n      right: 16px;\n      left: 16px;\n      bottom: 16px;\n      width: auto;\n    }\n\n    .bulk-news-notice__inner {\n      padding: 15px 16px 16px;\n      border-radius: 12px;\n    }\n\n    .bulk-news-notice__headline {\n      font-size: 16px;\n      max-width: 100%;\n    }\n  }\n</style>\n\n<script>\n  (function() {\n    var notice = document.getElementById('bulk-news-notice');\n    if (!notice) return;\n\n    setTimeout(function() {\n      notice.classList.add('is-hiding');\n    }, {{ bulk_notice_seconds | times: 1000 | round }});\n\n    notice.addEventListener('animationend', function(e) {\n      if (e.animationName === 'bulkNewsFadeOut') {\n        notice.style.display = 'none';\n      }\n    });\n  })();\n</script>",
