        "custom_liquid": "{% comment %} High Volume Notice Popup {% endcomment %}\n\n<div id=\"hv-notif\" style=\"\n  position:fixed;\n  bottom:28px;\n  right:24px;\n  z-index:9999;\n  background:#1a1a1a;\n  border:1px solid #c9a84c;\n  border-top:3px solid #c9a84c;\n  border-radius:8px;\n  padding:18px 44px 18px 18px;\n  max-width:360px;\n  width:calc(100vw - 48px);\n  display:flex;\n  flex-direction:column;\n  gap:8px;\n  opacity:0;\n  transform:translateY(30px);\n  transition:transform 0.55s cubic-bezier(.22,1,.36,1), opacity 0.5s ease;\n\">\n  <button onclick=\"hvClose()\"\n    style=\"position:absolute;top:10px;right:13px;background:none;border:none;color:#c9a84c;font-size:17px;cursor:pointer;line-height:1;padding:0;\"\n    aria-label=\"Close\">✕</button>\n\n  <div style=\"display:flex;align-items:center;gap:8px;\">\n    <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#c9a84c\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\"/></svg>\n    <span style=\"font-size:10px;letter-spacing:2.5px;color:#c9a84c;text-transform:uppercase;font-weight:600;\">Site Notice</span>\n  </div>\n\n  <p style=\"font-size:13px;color:#dddddd;line-height:1.65;margin:0;\">\n    We are currently experiencing a <span style=\"color:#c9a84c;font-weight:600;\">high volume of orders</span> and increased traffic. You may notice slight delays while browsing the website; shipping times are the same as usual <span style=\"color:#ffffff;font-weight:600;\">(1–3 business days)</span>. Thank you for your patience and cooperation.\n  </p>\n\n  <div id=\"hv-bar\" style=\"position:absolute;bottom:0;left:0;height:2px;background:#c9a84c;width:100%;border-radius:0 0 6px 6px;\"></div>\n</div>\n\n<script>\n  (function() {\n    if (sessionStorage.getItem('hv_notice_seen')) return;\n\n    var notif = document.getElementById('hv-notif');\n    var bar = document.getElementById('hv-bar');\n    var autoTimer;\n\n    setTimeout(function() {\n      notif.style.opacity = '1';\n      notif.style.transform = 'translateY(0)';\n      bar.style.transition = 'width 10s linear';\n      setTimeout(function() { bar.style.width = '0%'; }, 50);\n      autoTimer = setTimeout(hvClose, 10500);\n    }, 3000);\n\n    window.hvClose = function() {\n      clearTimeout(autoTimer);\n      notif.style.opacity = '0';\n      notif.style.transform = 'translateY(30px)';\n      sessionStorage.setItem('hv_notice_seen', '1');\n    };\n  })();\n</script>",
